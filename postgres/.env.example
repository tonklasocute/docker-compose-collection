# PostgreSQL 16 + pgAdmin
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords.

# --- PostgreSQL --------------------------------------------------------------
# Superuser name.
POSTGRES_USER=postgres
# REQUIRED. Superuser password.
POSTGRES_PASSWORD=change-me-postgres
# Database created for the superuser on first start.
POSTGRES_DB=postgres
# Host port, bound to 127.0.0.1.
POSTGRES_PORT=5432

# --- Sample application database ----------------------------------------------
# Created by init/01-create-app-db.sh the first time the data volume is empty.
# Changing these later has no effect until you `make reset`.
APP_DB_NAME=app
APP_DB_USER=app
# REQUIRED. Password for APP_DB_USER.
APP_DB_PASSWORD=change-me-app

# --- pgAdmin (profile: tools) --------------------------------------------------
# Login e-mail. Must look like a real address (pgAdmin rejects e.g. admin@localhost).
PGADMIN_EMAIL=admin@example.com
# REQUIRED. Login password.
PGADMIN_PASSWORD=change-me-pgadmin
# Host port for the web UI, bound to 127.0.0.1.
PGADMIN_PORT=5050
