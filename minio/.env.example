# MinIO (S3-compatible object storage)
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real keys.

# --- Root (admin) account: console login, `mc admin` -------------------------------
MINIO_ROOT_USER=admin
# REQUIRED. At least 8 characters.
MINIO_ROOT_PASSWORD=change-me-minio

# --- Application access (what your code uses) ----------------------------------------
# Buckets created on start, comma-separated.
MINIO_BUCKETS=app,uploads
# S3 access key of a user that can only use MINIO_BUCKETS.
MINIO_APP_ACCESS_KEY=app
# REQUIRED. S3 secret key, at least 8 characters.
MINIO_APP_SECRET_KEY=change-me-minio-app

# --- Host ports (bound to 127.0.0.1) -----------------------------------------------
# S3 API.
MINIO_PORT=9000
# Web console.
MINIO_CONSOLE_PORT=9001
