# GitLab Runner (Docker executor)
# Copy to .env (`cp .env.example .env`) and fill in the values marked REQUIRED.
# .env is git-ignored; never commit a runner token.

# --- Registration (used by ./register.sh, not by compose) ----------------------
# Your GitLab instance.
GITLAB_URL=https://gitlab.com
# REQUIRED for ./register.sh. Runner authentication token (starts with glrt-).
# Create it in GitLab: project/group > Settings > CI/CD > Runners > New runner.
# Tags, description and "run untagged jobs" are set there, not here.
RUNNER_TOKEN=
# Name shown in GitLab's runner list for this machine.
RUNNER_NAME=docker-runner
# Image for jobs whose .gitlab-ci.yml has no `image:`.
RUNNER_DEFAULT_IMAGE=alpine:3.24.2
# How many jobs this runner process may run at the same time.
RUNNER_CONCURRENT=2
# Memory limit for each job container (Docker syntax: 512m, 2g, ...).
RUNNER_JOB_MEMORY=2g

# --- Runner process ------------------------------------------------------------
# Host port for Prometheus metrics (/metrics), bound to 127.0.0.1.
RUNNER_METRICS_PORT=9252
