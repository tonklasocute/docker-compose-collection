# Elasticsearch 8 + Kibana
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords.
#
# Only the elastic superuser password lives here. The kibana_system password
# and Kibana's encryption keys are generated by the setup container and kept
# in the `certs` volume.

# --- Elasticsearch -------------------------------------------------------------
# REQUIRED. Password for the `elastic` superuser (also your Kibana login).
# At least 6 characters.
ELASTIC_PASSWORD=change-me-elastic
# Host port for the HTTPS API, bound to 127.0.0.1.
ES_PORT=9200
ES_CLUSTER_NAME=docker-cluster
# JVM heap (-Xms/-Xmx). Keep it at or below half of ES_MEMORY_LIMIT.
ES_HEAP=512m
# Container memory limit (heap + off-heap + file cache).
ES_MEMORY_LIMIT=1536m

# --- Kibana (profile: tools) -----------------------------------------------------
# Host port for the web UI, bound to 127.0.0.1.
KIBANA_PORT=5601
