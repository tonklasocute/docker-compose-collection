# Traefik v3 reverse proxy
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored.

# --- Routing -------------------------------------------------------------------------
# Base domain. Services get <name>.$DOMAIN (whoami.localhost, traefik.localhost).
# *.localhost resolves to 127.0.0.1 in browsers and curl without any DNS setup.
DOMAIN=localhost
# Interface for ports 80/443. 127.0.0.1 = this machine only. On a server that
# should get real certificates, use 0.0.0.0.
TRAEFIK_BIND_IP=127.0.0.1
# Docker network that routed containers join (shared with other projects).
PROXY_NETWORK=traefik-proxy

# --- Let's Encrypt -------------------------------------------------------------------
# Contact address for the ACME account (optional; expiry notices).
ACME_EMAIL=
# ACME directory. Test against staging first to avoid production rate limits:
#   https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# --- Dashboard (https://traefik.$DOMAIN) ---------------------------------------------
# REQUIRED. htpasswd line(s) "user:bcrypt-hash", comma-separated for several
# users. Generate one with: make htpasswd u=admin p='your password'
# Keep the single quotes: the hash contains $ characters.
# This example hash is for admin / change-me-traefik.
TRAEFIK_DASHBOARD_USERS='admin:$2y$10$I3.8o6dwoQtK4Tac5nWGzuD/fYW/MjRkIJZaiNX0Ucoi9whBCP7PO'
# DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO
