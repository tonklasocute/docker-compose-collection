# Go API + PostgreSQL
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords.

# --- PostgreSQL --------------------------------------------------------------
# Database owner; the API connects as this user.
POSTGRES_USER=app
# REQUIRED. Used in DATABASE_URL: letters, digits, - and _ only (or URL-encode).
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=app
# Host port, bound to 127.0.0.1.
POSTGRES_PORT=5432

# --- API -----------------------------------------------------------------------
# Host port for the production image (service `api`), bound to 127.0.0.1.
API_PORT=8080
# Host port for the hot-reload container (service `api-dev`, profile: dev).
API_DEV_PORT=8081
# Version string baked into the binary, reported by GET /health.
API_VERSION=1.0.0
# debug | info | warn | error
LOG_LEVEL=info
