# RabbitMQ 4
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords.

# --- Broker ----------------------------------------------------------------------
# Admin user, created on first start (empty volume) only.
RABBITMQ_USER=app
# REQUIRED. Password for RABBITMQ_USER.
RABBITMQ_PASSWORD=change-me-rabbitmq
# Virtual host created on first start; definitions.json is imported into it.
RABBITMQ_VHOST=app

# --- Host ports (bound to 127.0.0.1) --------------------------------------------
# AMQP 0-9-1 / AMQP 1.0 clients.
RABBITMQ_AMQP_PORT=5672
# Management UI and HTTP API.
RABBITMQ_UI_PORT=15672
