# NestJS API + PostgreSQL + Redis
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords.
# Passwords go into connection URLs: letters, digits, - and _ (or URL-encode).

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=app
# REQUIRED.
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=app
# Host port, bound to 127.0.0.1.
POSTGRES_PORT=5432

# --- Redis (cache) -------------------------------------------------------------
# REQUIRED.
REDIS_PASSWORD=change-me-redis
# Host port, bound to 127.0.0.1.
REDIS_PORT=6379
# How long GET /api/v1/notes/:id responses stay cached.
CACHE_TTL_SECONDS=60

# --- API -----------------------------------------------------------------------
# Host port for the production image (service `api`), bound to 127.0.0.1.
API_PORT=3000
# Host port for the watch-mode container (service `api-dev`, profile: dev).
API_DEV_PORT=3001
# Reported by GET /health.
API_VERSION=1.0.0
