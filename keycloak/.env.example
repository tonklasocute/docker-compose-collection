# Keycloak 26 + PostgreSQL 16
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords or client secrets.

# --- Keycloak ----------------------------------------------------------------------
# Temporary admin of the master realm, created on the first start only.
# Log in, create a permanent admin, then delete this one.
KEYCLOAK_ADMIN=admin
# REQUIRED.
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
# Host port, bound to 127.0.0.1.
KEYCLOAK_PORT=8080
# Public URL that browsers use and tokens name as issuer. Empty means
# http://localhost:$KEYCLOAK_PORT. Behind a proxy: https://auth.example.com
KEYCLOAK_URL=
# Log level: INFO, DEBUG, WARN, ...
KEYCLOAK_LOG_LEVEL=INFO

# --- Sample realm "demo" (realms/demo-realm.json, imported on first start) -----------
# REQUIRED. Password of the user "demo".
DEMO_USER_PASSWORD=change-me-demo
# REQUIRED. Client secret of the confidential client "demo-service".
DEMO_CLIENT_SECRET=change-me-demo-service-secret

# --- PostgreSQL (internal only, not published) ------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
# REQUIRED.
POSTGRES_PASSWORD=change-me-postgres
