# Next.js + Go API + PostgreSQL + nginx
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords.

# --- Public entry point -------------------------------------------------------
# Host port for nginx, bound to 127.0.0.1. The only port this stack publishes.
HTTP_PORT=8080

# --- PostgreSQL (internal only) -----------------------------------------------
POSTGRES_USER=app
# REQUIRED. Used in DATABASE_URL: letters, digits, - and _ only (or URL-encode).
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=app

# --- Go API (internal only) ----------------------------------------------------
# Version baked into the binary, shown on the page and by /api/health.
API_VERSION=1.0.0
# debug | info | warn | error
LOG_LEVEL=info
