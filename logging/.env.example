# Loki + Alloy + Grafana
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords.
# Log retention is set in loki/config.yaml (limits_config.retention_period).

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# REQUIRED. Grafana admin password (applied on the first start only).
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Host port for the web UI, bound to 127.0.0.1.
GRAFANA_PORT=3000

# --- Loki / Alloy ------------------------------------------------------------
# Loki HTTP API (push + query), bound to 127.0.0.1.
LOKI_PORT=3100
# Alloy debug UI, bound to 127.0.0.1.
ALLOY_PORT=12345
