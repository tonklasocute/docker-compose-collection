# Prometheus + Grafana + node-exporter + cAdvisor
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords.

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# REQUIRED. Grafana admin password (applied on the first start only).
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Host port for the web UI, bound to 127.0.0.1.
GRAFANA_PORT=3000

# --- Prometheus --------------------------------------------------------------
# Host port for the web UI / API, bound to 127.0.0.1.
PROMETHEUS_PORT=9090
# How long to keep samples, e.g. 15d, 90d, 1y.
PROMETHEUS_RETENTION=15d
