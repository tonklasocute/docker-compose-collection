# Apache Kafka 4 (KRaft) + Kafka UI
# Copy to .env (`cp .env.example .env`). Values marked REQUIRED must be set.
# .env is git-ignored; never commit real passwords.

# --- Kafka -------------------------------------------------------------------
# REQUIRED. KRaft cluster id (base64 UUID). Fixed so the data volume keeps
# matching it. Generate your own with:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
# Host port for clients on this machine (bootstrap localhost:9092).
KAFKA_PORT=9092
# Comma-separated topics created on startup by the kafka-init container.
KAFKA_TOPICS=events,orders
# Partitions for those topics.
KAFKA_TOPIC_PARTITIONS=3
# Create topics automatically when a client first uses them. Off by default so
# a typo in a topic name is an error instead of a new, empty topic.
KAFKA_AUTO_CREATE_TOPICS=false
# How long messages are kept.
KAFKA_RETENTION_HOURS=168

# --- Kafka UI (profile: tools) ---------------------------------------------------
# Login for the web UI.
KAFKA_UI_USER=admin
# REQUIRED. Password for the web UI.
KAFKA_UI_PASSWORD=change-me-kafka-ui
# Host port for the web UI, bound to 127.0.0.1.
KAFKA_UI_PORT=8080
