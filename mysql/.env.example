# MySQL 8.4 LTS + Adminer
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords.

# --- MySQL -------------------------------------------------------------------
# REQUIRED. Password for the MySQL root account.
MYSQL_ROOT_PASSWORD=change-me-root
# Application database, created on first start.
MYSQL_DATABASE=app
# Application user, granted all privileges on MYSQL_DATABASE only.
MYSQL_USER=app
# REQUIRED. Password for MYSQL_USER.
MYSQL_PASSWORD=change-me-app
# Host port, bound to 127.0.0.1.
MYSQL_PORT=3306
# InnoDB buffer pool size. Roughly 50-70% of the container memory limit (1g).
MYSQL_BUFFER_POOL_SIZE=256M
# Server time zone.
TZ=UTC

# --- Adminer (profile: tools) ---------------------------------------------------
# Host port for the web UI, bound to 127.0.0.1.
ADMINER_PORT=8080
