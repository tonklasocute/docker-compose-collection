# MongoDB 7.0 replica set + mongo-express
# Copy to .env (`cp .env.example .env`) and change every value marked REQUIRED.
# .env is git-ignored; never commit real passwords.
# Passwords end up in connection URLs: stick to letters, digits, - and _ or
# URL-encode them (e.g. @ -> %40).

# --- MongoDB -----------------------------------------------------------------
# Root user (admin database).
MONGO_ROOT_USER=root
# REQUIRED. Root password.
MONGO_ROOT_PASSWORD=change-me-root
# Replica set name. Clients must use the same value (?replicaSet=rs0).
MONGO_REPLICA_SET=rs0
# Host port, bound to 127.0.0.1.
MONGO_PORT=27017

# --- Sample application database ----------------------------------------------
# Created by init/01-create-app-user.js the first time the data volume is empty.
APP_DB_NAME=app
APP_DB_USER=app
# REQUIRED. Password for APP_DB_USER (readWrite on APP_DB_NAME only).
APP_DB_PASSWORD=change-me-app

# --- mongo-express (profile: tools) ---------------------------------------------
# Web UI login (HTTP basic auth).
MONGO_EXPRESS_USER=admin
# REQUIRED. Web UI password.
MONGO_EXPRESS_PASSWORD=change-me-express
# Host port for the web UI, bound to 127.0.0.1.
MONGO_EXPRESS_PORT=8081
